# Sandbox-ready workload image for the OpenShell-governed agent.
#
# Layout contract (referenced by the provider profiles in openshell/profile/
# and by the sandbox policy in openshell/policy/):
#   /sandbox/.venv/bin/python   the agent interpreter (uv venv)
#   /sandbox                    workdir (filesystem_policy include_workdir)
#
# Non-root (uid/gid 1500, user `sandbox` — matches process.run_as_user "1500"
# in the sandbox policy), no baked secrets, no credential files.
# Build with the OpenShell-supported runtime only, e.g.:
#   podman build -f agent/Dockerfile.sandbox -t localhost/smart-crowd-counter-agent:v1 agent/
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder
WORKDIR /sandbox

COPY pyproject.toml uv.lock README.md .python-version ./
RUN uv sync --frozen --no-install-project --no-dev

COPY src ./src
RUN uv sync --frozen --no-dev --no-editable

FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 1500 sandbox \
    && useradd -u 1500 -g 1500 -m -d /sandbox -s /usr/sbin/nologin sandbox

WORKDIR /sandbox
COPY --from=builder /sandbox/.venv /sandbox/.venv
COPY src ./src

ENV PATH="/sandbox/.venv/bin:$PATH"
USER sandbox
EXPOSE 8000
CMD ["uvicorn", "smart_crowd_counter:app", "--host", "0.0.0.0", "--port", "8000"]
