# Snowflake connection (local development)
# Uses ~/.snowflake/connections.toml — set the connection name here
SNOWFLAKE_DEFAULT_CONNECTION_NAME=default

# App configuration (override object names if needed)
SNOWFLAKE_DATABASE=CROWD_COUNTER_DB
SNOWFLAKE_SCHEMA=CONFERENCES
SNOWFLAKE_STAGE=SNAPS
AI_MODEL=claude-4-sonnet
