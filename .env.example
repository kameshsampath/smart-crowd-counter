# MinIO AIStor / S3-compatible object storage
S3_ENDPOINT=localhost:9000
# Root credentials: AIStor console login and aistor-init bootstrap
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Scoped service user used by the web app (created by aistor-init in docker compose)
S3_APP_USER=crowd-counter
S3_APP_SECRET=crowd-counter-dev-secret
S3_USE_TLS=false
S3_PHOTOS_BUCKET=snaps
S3_RESULTS_BUCKET=analysis

# Google ADK Agent & Ollama local inference
AGENT_URL=http://localhost:8000
AGENT_MODEL=qwen2.5vl:7b
AGENT_TIMEOUT_MS=300000
# Ollama context window and max image edge (px) sent to the vision model
OLLAMA_NUM_CTX=8192
MAX_INFERENCE_DIMENSION=1280
OLLAMA_BASE_URL=http://localhost:11434
# Docker Compose only: use Ollama running on the host (saves RAM) instead of the
# bundled container, e.g. COMPOSE_OLLAMA_URL=http://host.docker.internal:11434
# COMPOSE_OLLAMA_URL=

# HMAC secret for library reset retry tokens
RESET_SECRET=local-dev-reset-secret
